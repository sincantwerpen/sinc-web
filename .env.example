# Copy to .env.local for local development. In production these go in Vercel
# (Project → Settings → Environment Variables), never in git. Everything is optional:
# without them the site shows its own content from src/content and the forms say so.

# --- SINC dashboard (events, registration, tickets, team, photos, contact) -----
# Base URL of the dashboard. Locally the dashboard's `npm run dev`: http://localhost:3100
DASHBOARD_URL=
# Shared key, the same value as DASHBOARD_API_KEY in the dashboard. Locally e.g. local-dev-key
DASHBOARD_API_KEY=

# --- Newsletter (Flexmail), see README ----------------------------------------
FLEXMAIL_ACCOUNT_ID=
FLEXMAIL_TOKEN=
FLEXMAIL_OPT_IN_FORM_ID=
# FLEXMAIL_SOURCE_ID=
# NEWSLETTER_WEBHOOK_URL=

# --- Contact form fallback when the dashboard is not configured (e.g. Formspree) --
# CONTACT_WEBHOOK_URL=
